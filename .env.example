# Template for the repo-root .env -- SAFE TO COMMIT.
#
# Copy to .env and fill in. The real .env is gitignored (along with .env.local,
# .env.backup and friends); this file exists so the variable *names* are
# documented in version control while the values never are.
#
#   cp .env.example .env && ${EDITOR:-nano} .env
#
# Consumed by sandbox/fastq_to_bam/fastq_to_bam.sh -- see
# sandbox/fastq_to_bam/README_fastqexamples.md for what each one does.

# --- data locations -------------------------------------------------------
# $SANDBOX and $REPO are set by the script before it sources this file, so
# these stay correct no matter which directory you run from. A bare relative
# path like `sandbox/big_data` would be resolved against your current
# directory instead, and breaks the moment you `cd sandbox/fastq_to_bam`.
FASTQ_DIR=$SANDBOX/big_data/input
BAM_DIR=$SANDBOX/big_data/outputs
TMPDIR=$SANDBOX/big_data/tmp

# --- reference ------------------------------------------------------------
# REF_FASTA is the genome you align TO -- a .fa/.fasta of chromosomes. It is
# NOT your sequencing reads. Reads have no variable at all: they are found in
# $FASTQ_DIR, or passed as arguments to the script.
#
#   REF_FASTA=$SANDBOX/big_data/Homo_sapiens.GRCh38.dna.chromosome.19.fa
#
# REF_MMI is optional; set it to reuse a prebuilt minimap2 index and skip the
# index build. REF_GTF is the annotation, used by nexons rather than by the
# alignment, and its chromosome names must match REF_FASTA's ("19", not
# "chr19", for Ensembl).
REF_FASTA=
REF_MMI=
REF_GTF=
# Leave JUNC_BED empty for cryptic-exon work: rewarding annotated junctions
# biases against the unannotated ones you are looking for.
JUNC_BED=

# --- resources ------------------------------------------------------------
THREADS=16
SORT_THREADS=4
SORT_MEM=512M
SECONDARY=no

# --- FTP transfer ---------------------------------------------------------
# Prefer a ~/.netrc (chmod 600) over putting a password here: a password in a
# variable is visible to `ps` for every process this shell launches, and one
# stray `git add -f` puts it in history forever.
FTP_HOST=
FTP_USER=
FTP_PASS=
